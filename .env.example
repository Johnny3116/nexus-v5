# Nexus — environment template.
# Copy to `.env` (which is gitignored) and fill in. Process restart required
# after any change (settings loader uses a module-level singleton — see the
# 2026-03-27 lesson in CLAUDE.md §12).

# ---- Supabase -------------------------------------------------------------
SUPABASE_URL=REPLACE_WITH_SUPABASE_URL
SUPABASE_SERVICE_KEY=REPLACE_WITH_SERVICE_ROLE_KEY
SUPABASE_ANON_KEY=REPLACE_WITH_ANON_KEY

# ---- LLM: Anthropic (Claude Sonnet 4.6 direct) ----------------------------
ANTHROPIC_API_KEY=REPLACE_WITH_ANTHROPIC_API_KEY
ANTHROPIC_OAUTH_TOKEN=

# ---- LLM: Nexus-Agent gateway (OpenClaw — Codex GPT-5.4) ------------------
NEXUS_AGENT_URL=ws://100.108.226.115:18790
NEXUS_AGENT_TOKEN=nexus2026
NEXUS_AGENT_MODEL=openai-codex/gpt-5.4

# ---- LLM: Ollama (local Qwen) ---------------------------------------------
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=nexus-qwen

# ---- BrainPool model overrides (leave as-is unless pinning a version) -----
CLAUDE_MODEL=claude-sonnet-4-6
CODEX_MODEL=openai-codex/gpt-5.4
QWEN_MODEL=nexus-qwen

# ---- Gateway binding ------------------------------------------------------
# ecosystem.config.js overrides --host; this is a dev fallback.
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8000

# ---- Tailscale IPs (frozen per service_discovery/tailscale_ips.yaml) ------
NEXUS_BODY_IP=100.84.78.77
NEXUS_SERVER_IP=100.108.226.115
WORKSTATION_PRIME_IP=100.99.219.91

# ---- Security -------------------------------------------------------------
# Generate once:  python -c "import secrets; print(secrets.token_hex(32))"
INTER_SERVICE_SECRET=REPLACE_WITH_RANDOM_HEX
# Optional comma-separated IP allowlist (overrides the 100.64/10 CGNAT check).
TAILSCALE_ALLOWLIST=

# ---- Budgets --------------------------------------------------------------
CLAUDE_DAILY_BUDGET_USD=5.0
CLAUDE_MONTHLY_BUDGET_USD=100.0

# ---- Identity -------------------------------------------------------------
NEXUS_OWNER_IDENTITY=john

# ---- Alerting -------------------------------------------------------------
DISCORD_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=

# ---- GitHub (Phase 8 — Scout) --------------------------------------------
GITHUB_TOKEN=

# ---- Feature flags (all booleans: 1/true/yes/on vs. 0/false/no/off) -------
FEATURE_CLAUDE_ENABLED=1
FEATURE_CODEX_ENABLED=1
FEATURE_QWEN_ENABLED=1
FEATURE_CHAT_ENABLED=1
FEATURE_MEMORY_ENABLED=1
FEATURE_TASK_ENABLED=0
FEATURE_SKILL_ENABLED=0
FEATURE_INJECTION_SCANNER=0
FEATURE_SOUL_CONTAINER=0
