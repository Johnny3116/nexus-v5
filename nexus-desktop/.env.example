# Nexus Desktop — copy to .env and fill in

# ── Core ─────────────────────────────────────────────────────────────────────
# Bearer token — must match WORKSTATION_TOOL_TOKEN in NexusBody .env
WORKSTATION_TOOL_TOKEN=change-me-to-something-random

# Port the tool server listens on (default 8889)
WORKSTATION_TOOL_PORT=8889

# NexusBody VTube avatar server (Tailscale HTTPS)
NEXUS_AVATAR_URL=https://nexusbody.tail344870.ts.net:8001

# ── Supabase ──────────────────────────────────────────────────────────────────
# Project URL and service role key (or anon key for read-only)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-service-role-key
